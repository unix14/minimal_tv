<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/program_card_root"
    android:layout_width="@dimen/program_card_width"
    android:layout_height="@dimen/program_card_height"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardPreventCornerOverlap="false">

        <ImageView
            android:id="@+id/iv_program_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_banner_gradient" />

        <TextView
            android:id="@+id/tv_program_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
