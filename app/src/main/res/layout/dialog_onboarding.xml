<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="660dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#0E0E11"
    app:cardCornerRadius="16dp"
    app:cardElevation="24dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_onboarding_logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/onboarding_welcome"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/onboarding_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#27272A"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_onboarding_default_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_launcher"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_onboarding_set_default"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_selector"
                android:text="@string/onboarding_btn_default"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_accessibility"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_onboarding_enable_accessibility"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_selector"
                android:text="@string/onboarding_btn_accessibility"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_onboarding_start"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_selector"
            android:text="@string/onboarding_btn_start"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
