<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hdmi_card_root"
    android:layout_width="@dimen/app_card_width"
    android:layout_height="@dimen/app_card_height"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:id="@+id/iv_hdmi_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_ps5"
                android:scaleType="centerInside"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_hdmi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/hdmi_ps5_title"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hdmi_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="HDMI 2"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/layout_reorder_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_reorder_active"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layoutDirection="ltr"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/iv_arrow_left"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_left"
                        app:tint="#A5B4FC"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/reorder_overlay_move"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black" />

                    <ImageView
                        android:id="@+id/iv_arrow_right"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#A5B4FC"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/reorder_overlay_hint"
                    android:textColor="#C7D2FE"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
